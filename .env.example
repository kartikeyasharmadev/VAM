NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production deployment values (keep all secrets server-only)
CRON_SECRET=replace_with_a_long_random_secret
RESEND_API_KEY=re_replace_me
EMAIL_FROM="EntryFlow Billing <billing@yourdomain.com>"

# Stripe test-mode secrets (server only; never prefix these with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_TEAM=price_replace_me
STRIPE_PRICE_BUSINESS=price_replace_me

# Supabase secret key is server-only; used for staff invite emails and the signed Stripe webhook
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Keep these labels aligned with the recurring Stripe prices you create
NEXT_PUBLIC_STARTER_PRICE_LABEL=₹3,000 / month
NEXT_PUBLIC_TEAM_PRICE_LABEL=₹6,500 / month
NEXT_PUBLIC_BUSINESS_PRICE_LABEL=₹13,000 / month
